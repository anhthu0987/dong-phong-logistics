wqqwqcaxaxsaxservices:
  configurator:
    image: logistics-erpnext:operations-v1
  backend:
    image: logistics-erpnext:operations-v1
  websocket:
    image: logistics-erpnext:operations-v1
  queue-short:
    image: logistics-erpnext:operations-v1
  queue-long:
    image: logistics-erpnext:operations-v1
  scheduler:
    image: logistics-erpnext:operations-v1
  frontend:
    image: logistics-erpnext:operations-v1
    ports:
      - "127.0.0.1:8085:8080"
    environment:
      FRAPPE_SITE_NAME_HEADER: logistics.localhost
  db:
    image: mariadb:10.6
    environment:
      MARIADB_AUTO_UPGRADE: "0"
  redis-cache:
    image: redis:6.2-alpine
  redis-queue:
    image: redis:6.2-alpine
