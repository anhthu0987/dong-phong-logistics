    {"fieldname":"maintenance_plan","label":"Kế hoạch bảo dưỡng","fieldtype":"Link","options":"Fleet Maintenance Plan","reqd":1,"in_list_view":1},
    {"fieldname":"vehicle","label":"Xe","fieldtype":"Link","options":"Vehicle","reqd":1,"in_list_view":1},
    {"fieldname":"service_item","label":"Hạng mục bảo dưỡng","fieldtype":"Link","options":"Vehicle Service Item","reqd":1,"in_list_view":1},
    {"fieldname":"vehicle_log","label":"Nhật ký xe tham chiếu chi phí","fieldtype":"Link","options":"Vehicle Log","description":"Liên kết chi phí đã ghi ở Nhật ký xe để tránh ghi trùng."},
    {"fieldname":"work_date","label":"Ngày thực hiện bảo dưỡng","fieldtype":"Date","reqd":1},
