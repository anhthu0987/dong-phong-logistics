{
  "doctype": "DocType",
  "name": "Delivery Order",
  "module": "DP Dispatch",
  "autoname": "naming_series:",
  "naming_rule": "By Naming Series field",
  "naming_series": "DP-DO-.YYYY.-",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname":"naming_series","label":"Series","fieldtype":"Select","options":"DP-DO-.YYYY.-","default":"DP-DO-.YYYY.-","reqd":1,"hidden":1},
    {"fieldname":"customer","label":"Khách hàng","fieldtype":"Link","options":"Customer","reqd":1,"in_list_view":1},
    {"fieldname":"sender_section","label":"Thông tin người gửi","fieldtype":"Section Break"},
    {"fieldname":"sender_name","label":"Tên người gửi","fieldtype":"Data","reqd":1,"in_list_view":1},
    {"fieldname":"sender_phone","label":"Số điện thoại người gửi","fieldtype":"Data","reqd":1},
    {"fieldname":"pickup_address","label":"Địa chỉ lấy hàng","fieldtype":"Small Text","reqd":1,"description":"Địa chỉ tài xế đến nhận kiện hàng."},
    {"fieldname":"recipient_section","label":"Thông tin người nhận","fieldtype":"Section Break"},
    {"fieldname":"recipient_name","label":"Tên người nhận","fieldtype":"Data","reqd":1},
    {"fieldname":"recipient_phone","label":"Số điện thoại người nhận","fieldtype":"Data","reqd":1},
    {"fieldname":"delivery_address","label":"Địa chỉ giao hàng","fieldtype":"Small Text","reqd":1},
    {"fieldname":"delivery_city","label":"Tỉnh/Thành phố giao hàng","fieldtype":"Data","reqd":1},
    {"fieldname":"delivery_country","label":"Quốc gia giao hàng","fieldtype":"Link","options":"Country","default":"Vietnam","reqd":1},
    {"fieldname":"shipping_address","label":"Địa chỉ giao hàng liên kết","fieldtype":"Link","options":"Address","read_only":1,"hidden":1},
    {"fieldname":"delivery_date","label":"Thời gian yêu cầu giao","fieldtype":"Datetime","in_list_view":1},
    {"fieldname":"cargo_section","label":"Thông tin hàng hóa","fieldtype":"Section Break"},
    {"fieldname":"items","label":"Danh sách hàng hóa/kiện hàng","fieldtype":"Table","options":"Delivery Order Item","reqd":1},
    {"fieldname":"total_quantity_display","label":"Tổng số lượng","fieldtype":"Data","read_only":1,"in_list_view":1},
    {"fieldname":"total_weight_kg","label":"Tổng khối lượng (kg)","fieldtype":"Float","read_only":1},
    {"fieldname":"shipping_section","label":"Cước vận chuyển","fieldtype":"Section Break"},
    {"fieldname":"shipping_fee","label":"Cước vận chuyển","fieldtype":"Currency","default":0,"non_negative":1,"reqd":1,"in_list_view":1},
    {"fieldname":"fee_payer","label":"Bên trả cước","fieldtype":"Select","options":"Recipient","default":"Recipient","reqd":1,"description":"Hiện tại cước được thu từ người nhận khi giao hàng."},
    {"fieldname":"fee_paid","label":"Cước đã thu","fieldtype":"Currency","default":0,"read_only":1},
    {"fieldname":"fee_status","label":"Tình trạng thanh toán cước","fieldtype":"Select","options":"Not Required\nUnpaid\nPartially Paid\nPaid","default":"Unpaid","read_only":1,"in_list_view":1},
    {"fieldname":"delivery_status","label":"Trạng thái giao hàng","fieldtype":"Select","options":"Draft\nPending Assignment\nAssigned\nIn Transit\nDelivered\nPartial\nReturned\nCancelled","default":"Draft","read_only":1,"in_list_view":1},
    {"fieldname":"instructions","label":"Ghi chú giao hàng","fieldtype":"Small Text"}
  ],
  "permissions": [
    {"role":"System Manager","read":1,"write":1,"create":1,"delete":1,"submit":1,"cancel":1,"amend":1},
    {"role":"Fleet Manager","read":1,"write":1,"create":1,"submit":1},
    {"role":"DP Driver","read":1,"select":1}
  ],
  "sort_field":"modified",
  "sort_order":"DESC",
  "engine":"InnoDB"
